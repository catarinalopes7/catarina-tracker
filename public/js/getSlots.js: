// public/js/getSlots.js

async function getSlots() {
    try {
        const r = await fetch(`${SUPABASE_URL}/rest/v1/slots?select=*&order=provider.asc`, {
            method: "GET",
            headers
        });

        if (!r.ok) {
            const erro = await r.text();
            console.error("Erro ao buscar slots:", erro);
            return [];
        }

        const data = await r.json();
        return data;

    } catch (err) {
        console.error("Erro de ligação ao buscar slots:", err);
        return [];
    }
}
