async function getSlots() {
    const { data, error } = await supabase
        .from("slots")
        .select("*")
        .order("provider", { ascending: true });

    if (error) {
        console.error(error);
        return [];
    }

    return data;
}

<script src="/js/getSlots.js"></script>
<script>
getSlots().then(slots => {
    console.log("Slots carregados:", slots);
});
</script>
